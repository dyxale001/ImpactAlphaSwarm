# Backend environment variables for Sentiment Scout
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_key_here
# Overrides the default in src/utils/llm_client.py, so a retired model can be swapped
# on a running service without a deploy. Check console.groq.com for what is still live:
# llama-3.3-70b-versatile was withdrawn in June 2026 and every chat model Groq now
# offers is a reasoning model.
GROQ_MODEL=openai/gpt-oss-20b
# Reasoning models spend part of max_tokens thinking before they write. "low" keeps
# that to a few tokens; leave it alone unless a replacement model rejects the
# parameter, in which case set it to "none" and raise the budgets instead.
GROQ_REASONING_EFFORT=low

LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=AlphaSwarm
LANGSMITH_TRACING=true

SUPABASE_URL=_
SUPABASE_SERVICE_ROLE_KEY=_

API_CORS_ORIGINS=http://localhost:5173

# Google Cloud Natural Language API (dual-signal sentiment alongside VADER).
GOOGLE_NLP_API_KEY=
# Optional tuning (defaults shown): monthly unit cap, how many of the highest
# priority posts per ticker also get a GCP signal, and how many of those calls may
# be in flight at once. One call is one billed unit (text is truncated to 1000
# chars), and a run costs at most tickers x 2 sources x TOP_N, so 30 tickers at 10
# is 600 units. Billing is 5,000 units free per month, then $1.00 per 1,000.
# Set the budget above a month of runs or scoring silently drops to VADER only
# partway through the month: 40000 covers a nightly run plus manual refreshes for
# roughly $35 a month.
GOOGLE_NLP_MONTHLY_BUDGET=40000
GCP_SENTIMENT_TOP_N=10
GCP_SENTIMENT_MAX_WORKERS=10

# Nightly scheduled run (/api/analysis/run-daily). DAILY_RUN_SECRET must match the
# X-Daily-Run-Secret header on the Cloud Scheduler job; if unset the endpoint is
# disabled (503). Generate with: openssl rand -hex 32
DAILY_RUN_SECRET=your_daily_run_secret_here
# Only refresh users whose last run is within this many days (default 7).
DAILY_ACTIVE_DAYS=7
FINNHUB_API_KEY=
# Marketaux (marketaux.com) — tier-1-only supplemental news source. Optional: if
# unset, news falls back to Finnhub only. Free plan is ~100 calls/DAY at ~3 articles
# each, so the API is called ONLY by the nightly batch (deep pagination) and cached;
# user refreshes read the cache. Tuning: MARKETAUX_MAX_PAGES (default 25),
# MARKETAUX_CACHE_MAX_AGE_HOURS (default 48).
MARKETAUX_API_KEY=

# News sentiment scoring uses a two-level blend: fixed tier shares ACROSS reliability
# tiers (NEWS_TIER{1,2,3}_SHARE default 0.6/0.3/0.1) and a recency time-decay WITHIN
# each tier (newer articles weighted more). Half-life in days below; set very high to
# effectively disable recency decay.
NEWS_RECENCY_HALFLIFE_DAYS=2

# StockTwits (social chatter). No key is required, but registering an app and setting
# a client id raises the rate ceiling above the unauthenticated one. Leave blank to
# run unauthenticated.
STOCKTWITS_CLIENT_ID=
# Minimum seconds between StockTwits calls, process-wide (default 1.0).
STOCKTWITS_MIN_INTERVAL_SECONDS=1.0