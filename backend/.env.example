# Backend environment variables.
#
# Copy this file to backend/.env and fill in the four placeholders: the two
# Supabase values from the shared project, your own Groq key, your own Finnhub
# key. Everything not listed here has a default in code that is already correct.
#
# The sections are ordered by what it costs you to leave a variable out. Only
# section 1 tells you it is unhappy; the rest fail quietly.


# 1. REQUIRED. The process raises at import without these.
#
# supabase_client.py raises RuntimeError if either is unset, and every module
# imports it. Use the service role key, not the anon key the frontend uses:
# the backend writes past row level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here


# 2. REQUIRED IN PRACTICE. No key means no LLM output and no error.
#
# With GROQ_API_KEY unset the client builder returns None, so a run finishes
# with no reasoning traces and no discovery candidates, and nothing in the logs
# looks wrong. Register your own free key at console.groq.com. Rate limits are
# per account, so a key shared across the team just means everyone queues.
GROQ_API_KEY=your_groq_key_here

# Optional extra accounts, one per Groq account, each with its own rate limit.
#
#   GROQ_API_KEY, 2, 3   the reasoning trace fan out, one lane each.
#   GROQ_API_KEY3        also asset discovery, which falls back to GROQ_API_KEY.
#                        Safe only because the two never fire in the same minute.
#   GROQ_API_KEY4        the generated day summaries, falling back to GROQ_API_KEY.
#                        Its own account on purpose: a summary generates while
#                        somebody is reading a page, which is exactly when a user
#                        triggered run may be spending traces.
#
# Nothing reads GROQ_API_KEY5 or higher yet. If you set only GROQ_API_KEY every
# consumer falls back onto it and queues, which works and is slower.
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=
# Both default in code (openai/gpt-oss-20b, low). Leave them unset. They exist
# so a retired model can be swapped on a running service without a deploy:
# llama-3.3-70b-versatile was withdrawn in June 2026 and every chat model Groq
# now offers is a reasoning model, which spends part of max_tokens thinking
# before it writes. "low" keeps that to a few tokens. If a replacement model
# rejects the parameter, set it to "none" and raise the token budgets instead.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_REASONING_EFFORT=low


# 3. PIPELINE FLAGS. Leave these out and you run a different pipeline.
#
# The code defaults are off and shadow, which is not what production runs.
# Anyone omitting these is on the legacy ranking path with discovery disabled,
# and their results will not reproduce anyone else's. Keep all four as below.
DISCOVERY_ENABLED=true
DISCOVERY_SHADOW_MODE=false
UNIFIED_RANKING_ENABLED=true
UNIFIED_RANKING_SHADOW=false


# 4. LOCAL FRONTEND ORIGIN, for CORS. This is also the code default, so it only
# matters if you serve the frontend on another port.
API_CORS_ORIGINS=http://localhost:5173


# 5. DATA SOURCES. Each degrades quietly when blank, so a thin run is usually a
# missing key rather than a bug.

# News sentiment, plus the discovery agent's news and liquidity signals.
# Without it the news half of sentiment comes back close to empty. Free key,
# one per person, same reason as Groq.
FINNHUB_API_KEY=

# Marketaux (marketaux.com), tier 1 only supplemental news. Blank falls back to
# Finnhub. The free plan is about 100 calls per DAY at ~3 articles each, shared
# by whoever holds the key, which is why only the nightly batch calls it (deep
# pagination, cached) while user refreshes read the cache. Leave blank locally.
# Tuning: MARKETAUX_MAX_PAGES (25), MARKETAUX_CACHE_MAX_AGE_HOURS (48).
MARKETAUX_API_KEY=

# Google Cloud Natural Language, the second sentiment signal alongside VADER.
# Blank means VADER only, which is the right local default.
#
# Leave this blank unless you are working on the GCP scoring path. Since
# migration 016_nlp_budget.sql the monthly spend ledger lives in Postgres, so
# every machine pointed at the same Supabase project draws down one shared
# counter, and each process supplies its own cap from its own
# GOOGLE_NLP_MONTHLY_BUDGET. One laptop set high can spend the production month
# on its own.
GOOGLE_NLP_API_KEY=

# Production only. One call is one billed unit (text truncated to 1000 chars)
# and a run costs at most tickers x 2 sources x GCP_SENTIMENT_TOP_N, so 30
# tickers at 10 is 600 units. Billing is 5,000 units free per month, then $1.00
# per 1,000. Set below a month of runs and scoring silently drops to VADER only
# partway through the month; 40000 covers a nightly run plus manual refreshes
# for roughly $35 a month. Tuning: GCP_SENTIMENT_TOP_N (10, how many of the
# highest priority posts per ticker also get a GCP signal),
# GCP_SENTIMENT_MAX_WORKERS (10, how many of those calls are in flight at once).
# GOOGLE_NLP_MONTHLY_BUDGET=40000

# StockTwits social chatter. No key is required and blank runs unauthenticated;
# registering an app and setting a client id raises the rate ceiling.
# Tuning: STOCKTWITS_MIN_INTERVAL_SECONDS (1.0, process wide floor between calls).
STOCKTWITS_CLIENT_ID=

# The social sentiment trend chart. Off means the scout behaves exactly as it did
# before the feature existed: same pages, same posts, same score, no writes. Turn it
# on only after running migrations/019 in the SQL editor.
SOCIAL_HISTORY_ENABLED=false

# Three windows, and the reason they are three rather than one. The first attempt at
# this used a single lookback for both the chart's depth and the collector's, which
# put a seven day crawl on the analysis run's path: thirty tickers seeding twelve
# pages each against the one second floor was six minutes of sleeping, about ten of
# that run's eighteen minutes.
#
#   SOCIAL_DISPLAY_DAYS (7)      calendar days on the chart, and how far a BACKFILL
#                                walks. Never used to size a walk inside a run.
#   SOCIAL_ACCUMULATE_DAYS (2)   how far back a RUN walks. A run only needs enough to
#                                build today's bar, so most tickers stop on page one.
#                                Two rather than one so a ticker with nothing posted
#                                today still has a social signal.
#   STOCKTWITS_DAY_MAX_PAGES (6) the page ceiling inside a run.
#   SOCIAL_BACKFILL_MAX_PAGES (30)  the page ceiling for a backfill, far higher
#                                because nothing waits on one. A page is ~30 posts,
#                                so six pages is under two days for a busy ticker and
#                                would fill two bars of seven on exactly the assets
#                                people open.
#
# Also: SOCIAL_BACKFILL_QUOTA (30, tickers per backfill pass),
# SOCIAL_BACKFILL_MAX_SECONDS (900), SOCIAL_COLLECT_MAX_SECONDS (180, the run's wall
# clock budget), STOCKTWITS_REQUEST_TIMEOUT (6), SOCIAL_DAY_TOP_POSTS (15),
# SOCIAL_RECOMMENDATION_POSTS (5), SOCIAL_BACKFILL_RECENT_DAYS (3).
# All default correctly in code; leave them unset.

# The news line on that same chart. Its own switch rather than riding on the social
# one: the two write different tables through different merges, and either should be
# stoppable without the other. Turn it on only after running migrations/021.
#
# Off is not a broken chart. The frontend falls back to deriving a news line from the
# article list on ai_recommendation, which is roughly right and was the only option
# before this existed. On replaces that with stored history, which differs in three
# ways worth the migration: it weights reliability tiers within the day instead of by
# an influence figure computed across the whole week, it does not rewrite its own past
# when a later run fetches a different set of articles, and it can outlive the news
# lookback so the chart could show thirty days rather than seven.
#
# Cheap to switch on. The articles are already fetched and already scored for the
# sub-score, so this adds one RPC per run, no API call and no NLP spend. It needs no
# backfill either: a run holds the whole lookback at once, so the first run after you
# enable it fills all seven days rather than one a night.
NEWS_HISTORY_ENABLED=false

# Also: NEWS_DAY_TOP_ARTICLES (8, how many of a day's articles are kept on its row).
# Defaults correctly in code; leave it unset.

# Intraday top-up ticks. Off means nothing collects between the nightly runs, which is
# the behaviour before this existed: the 22:00 job writes the day that just ended, so
# TODAY's bar is empty from midnight UTC until late evening, which is most of the time
# anyone is looking at it. On, two scheduled ticks fill it in as the session runs.
#
# A tick is not a small backfill and does not reuse that job. It reads how far each
# ticker got (last_message_id), walks a page or two until it meets a post it has already
# counted, scores ONLY what is past that mark and adds it on. The order is the cost
# argument: the history filters by the mark anyway, so a tick that scored everything it
# walked would store the same number and pay GCP to rescore the same fifty posts. As
# written, a ticker with nothing new costs nothing at all.
#
# Needs SOCIAL_HISTORY_ENABLED too. Without it a tick walks, scores and drops the lot.
SOCIAL_TICK_ENABLED=false

# Also: SOCIAL_TICK_MAX_PAGES (2), SOCIAL_TICK_QUOTA (60 tickers a pass),
# SOCIAL_TICK_MAX_SECONDS (300), SOCIAL_TICK_RECENT_DAYS (1, how far back to look for
# tickers worth topping up) and SOCIAL_TICK_GCP_TOP_N (5, how many of a tick's NEW posts
# get the metered GCP signal rather than VADER alone). That last one is the dial to turn
# down first if ticks start crowding the nightly out of the monthly NLP budget, and up
# to GCP_SENTIMENT_TOP_N (10) to make a tick score exactly as a run does.
# All default correctly in code; leave them unset.

# Generated day summaries: the paragraph behind clicking a bar on the trend chart. Off
# means the bars are inert and the endpoint returns nothing. Run migrations/022 first.
#
# Cached in Postgres, and a day that has closed is generated ONCE: the row goes final
# and the merge RPC refuses to overwrite a final row at all, so a reader clicking back
# and forth across a week pays for that week once between them. A day still in progress
# is rewritten only when the cooldown has expired AND the post or article count has
# actually moved, so a page refresh never re-bills and a quiet afternoon never re-bills.
#
# Generation is lazy: a day is written the first time somebody opens it. The scheduled
# job at 00:30 UTC only tops up tickers that ALREADY have a stored summary, so no token
# is ever spent on a name nobody has looked at.
#
# Needs at least one of SOCIAL_HISTORY_ENABLED and NEWS_HISTORY_ENABLED, since those are
# what it writes from. Either alone is enough: with social off the prompt says plainly
# that no posts were collected and the paragraph covers the articles, and with news off
# it does the reverse.
DAY_SUMMARY_ENABLED=false

# Also: DAY_SUMMARY_TODAY_COOLDOWN_MINUTES (90), DAY_SUMMARY_MAX_CHARS (900, the guard
# against a model that returns an essay) and DAY_SUMMARY_EVIDENCE_ITEMS (3, how many of
# the day's top articles and posts the prompt offers).
# All default correctly in code; leave them unset.


# 6. TRACING. Optional. If you switch it on, use your own project name so local
# runs do not muddy the shared trace history.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AlphaSwarm-dev-yourname


# 7. PRODUCTION ONLY. Nothing below belongs in a local .env.
#
# The nightly scheduled run (/api/analysis/run-daily). DAILY_RUN_SECRET must
# match the X-Daily-Run-Secret header on the Cloud Scheduler job; unset means
# the endpoint returns 503, which is what you want on a laptop. Generate with:
# openssl rand -hex 32. DAILY_ACTIVE_DAYS (7) only refreshes users whose last
# run is within that many days.
#
# The same secret guards every other scheduled endpoint. Four jobs in total, and the
# order between them is deliberate rather than incidental:
#
#   22:00 UTC   /api/analysis/run-daily    the nightly batch.
#   23:00 UTC   /api/social/backfill       seeds tickers never walked. An hour after the
#                                          nightly because discovery runs at the top of
#                                          run-daily, so a ticker discovered tonight does
#                                          not exist yet for an earlier job and would sit
#                                          on one bar out of seven until tomorrow.
#   00:30 UTC   /api/sentiment/summaries   settles the day that just closed. Half past
#                                          midnight, not half eleven: run it an hour
#                                          earlier and yesterday stays marked "so far
#                                          today" until the following night.
#
#   09:35 and 13:35 America/New_York, MON-FRI   /api/social/tick
#                                          the intraday top-up, twice a session, and ONE
#                                          job rather than two: "35 9,13 * * 1-5" covers
#                                          both times. Set its timezone to
#                                          America/New_York rather than UTC, because the
#                                          US open moves an hour twice a year and a tick
#                                          that has drifted off the open misses the
#                                          loudest part of the session.
#
# Every one of them needs its attempt deadline raised well above Cloud Scheduler's 180s
# default.
# DAILY_RUN_SECRET=
# DAILY_ACTIVE_DAYS=7


# 8. FEATURE FLAGS. Off by default, and unlike section 3 that is the intended
# state: these gate features that are merged but not finished. Leaving them out
# gives you the app exactly as it runs today.
#
# FUNDS_ENABLED mounts /api/fund-catalogue and serves the funds catalogue (South
# African unit trusts and JSE-listed ETFs, matched to the onboarding profile from
# published fact sheets). Turn it on only against a database where migration 024
# has been applied and the seed loaded, or the page renders nothing. The frontend
# has its own switch, VITE_FUNDS_ENABLED, and both must be set for the feature to
# appear.
#
# FUND_TRACES_ENABLED turns the fund explanation over to the LLM. It is gated
# separately from the catalogue on purpose: the templated explanation needs no
# model, and the generated one must not ship before its guards and the copy
# review. Leave it off.
# FUNDS_ENABLED=false
# FUND_TRACES_ENABLED=false


# 9. EVERYTHING ELSE: leave unset.
#
# Around sixty further knobs read from the environment, all with defaults in
# code that are the intended values. Set one only for a deliberate experiment,
# and say so in the PR, because a stray override makes your run incomparable to
# everyone else's.
#
#   RANK_*                ranking weights, floors and data sufficiency caps
#   DISCOVERY_*           candidate filters, scoring weights and decay
#   NEWS_*                tier sources, weights, shares and recency half life
#   WHALE_*               insider and institutional cache TTLs and limits
#   QUANT_*               price window and minimum universe size
#   FINNHUB_*             cache age, live top up and rate limiting
#   MAX_SCOPED_TICKERS    per run ticker ceiling (30)
#   REASONING_TRACE_TOP_N how many ranked assets get a written trace (5)
#   DESCRIPTIONS_*        entity description generation
#   STALE_RUN_MINUTES     when a held run lock is treated as abandoned (15)
#   TRACES_DIR            where run traces are written (data/runs)
#   ALPHASWARM_CACHE_DIR  local cache root (data/cache)
#
# The one worth knowing about while debugging:
# LOG_LEVEL=DEBUG
