# Backend environment variables for Sentiment Scout
# Get free key at: https://console.groq.com
GROQ_API_KEY=your_groq_key_here

LANGSMITH_API_KEY=your_langsmith_key_here
LANGSMITH_PROJECT=AlphaSwarm
LANGSMITH_TRACING=true

SUPABASE_URL=_
SUPABASE_SERVICE_ROLE_KEY=_

API_CORS_ORIGINS=http://localhost:5173

# Google Cloud Natural Language API (dual-signal sentiment alongside VADER).
GOOGLE_NLP_API_KEY=
# Optional tuning (defaults shown): monthly unit cap (free tier guard) and how
# many of the most-engaged posts per ticker also get a GCP signal.
GOOGLE_NLP_MONTHLY_BUDGET=500
GCP_SENTIMENT_TOP_N=5

# Nightly scheduled run (/api/analysis/run-daily). DAILY_RUN_SECRET must match the
# X-Daily-Run-Secret header on the Cloud Scheduler job; if unset the endpoint is
# disabled (503). Generate with: openssl rand -hex 32
DAILY_RUN_SECRET=your_daily_run_secret_here
# Only refresh users whose last run is within this many days (default 7).
DAILY_ACTIVE_DAYS=7
FINNHUB_API_KEY=
# Marketaux (marketaux.com) — tier-1-only supplemental news source. Optional: if
# unset, news falls back to Finnhub only. Free plan is ~100 calls/DAY at ~3 articles
# each, so the API is called ONLY by the nightly batch (deep pagination) and cached;
# user refreshes read the cache. Tuning: MARKETAUX_MAX_PAGES (default 25),
# MARKETAUX_CACHE_MAX_AGE_HOURS (default 48).
MARKETAUX_API_KEY=

# News sentiment scoring uses a two-level blend: fixed tier shares ACROSS reliability
# tiers (NEWS_TIER{1,2,3}_SHARE default 0.6/0.3/0.1) and a recency time-decay WITHIN
# each tier (newer articles weighted more). Half-life in days below; set very high to
# effectively disable recency decay.
NEWS_RECENCY_HALFLIFE_DAYS=2

# StockTwits (social chatter). No key is required, but registering an app and setting
# a client id raises the rate ceiling well above the unauthenticated one, which makes
# the history seed crawl materially safer. Leave blank to run unauthenticated.
STOCKTWITS_CLIENT_ID=
# Minimum seconds between StockTwits calls, process-wide (default 1.0).
STOCKTWITS_MIN_INTERVAL_SECONDS=1.0

# Social sentiment history: stores each StockTwits post keyed by its message id so
# the same post is never downloaded twice, and rolls the posts up into one score per
# day to drive the two-week trend chart. Off by default; with the flag down the
# collector behaves exactly as it did before and neither history table is touched.
SOCIAL_HISTORY_ENABLED=false
# How many days the chart reaches back, and how far the one-off seed crawl walks
# (default 14). Widening this does NOT retroactively deepen a ticker already stored;
# delete that ticker's rows from stocktwits_message_cache to force a fresh seed.
SOCIAL_HISTORY_DAYS=14
# How long raw posts are kept (default 21). Deliberately longer than the window so
# rebuilding the oldest bucket still has its source rows.
SOCIAL_RETENTION_DAYS=21
# Page ceiling for a single history walk (default 12, 30 posts per page). Both the
# seed and the catch-up stop themselves -- the seed at the window edge, the catch-up
# at the first post already stored -- so a normal night costs one page regardless of
# this value, and the rest is only ever spent closing a real gap.
STOCKTWITS_HISTORY_MAX_PAGES=12